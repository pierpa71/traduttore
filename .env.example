# Copia in .env (facoltativo): docker compose lo legge automaticamente.
# Sono solo i valori PREDEFINITI della pagina: endpoint e modello si cambiano dall'interfaccia.

PORT=8080

# ollama | openai
LLM_PROVIDER=ollama
# Ollama sulla stessa macchina: http://localhost:11434 (viene girato automaticamente verso l'host)
# Ollama su un altro server: http://192.168.1.50:11434
# OpenAI-compatibile: https://api.openai.com/v1, http://server:8000/v1 (vLLM), ...
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=
# Usata se il campo API key nella pagina è vuoto (resta sul server)
LLM_API_KEY=

CHUNK_CHARS=2000
# Contesto passato a Ollama (token). 0 = default del modello
OLLAMA_NUM_CTX=8192
# 1 = disattiva il "thinking" dei modelli che ragionano (qwen3, deepseek-r1, gpt-oss)
NO_THINK=1
# secondi massimi senza risposta dal modello prima di dare errore
LLM_READ_TIMEOUT=900
LOG_LEVEL=INFO
CONCURRENCY=1
MAX_UPLOAD_MB=50
